# Copy to .env.local and fill in.
# Supabase project → Settings → API

# Safe to expose. Ships in the browser bundle by design — RLS is the security
# boundary, not key secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Postgres schema this app owns. The Supabase project is shared with other
# apps, so nothing lives in `public`. Must also be listed under
# Settings → API → Exposed schemas, or every query 404s.
NEXT_PUBLIC_SUPABASE_SCHEMA=hadid

# Server-side only. Bypasses RLS entirely — never prefix with NEXT_PUBLIC_,
# never import into a Client Component, never commit.
# Only needed for the keepalive cron; leave empty until then.
SUPABASE_SERVICE_ROLE_KEY=

# openssl rand -hex 32 — set in Vercel so the cron endpoint rejects strangers.
CRON_SECRET=
